	},
	"devDependencies": {
		"@biomejs/biome": "2.6.5",
		"@types/node": "26.6.6",
		"esbuild": "0.28.2",
		"typescript": "7.0.2",
		"vite": "8.3.6"
	},
	"type": "module"
}
