{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["DOM", "DOM.Iterable", "ES2022"],
		"strict": true,
		"noEmit": true,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowImportingTsExtensions": true,
		"types": ["node"],
		"skipLibCheck": true,
		"useDefineForClassFields": true
	},
	"include": ["buzzer/src", "matrix/src", "vite.config.ts"]
}
