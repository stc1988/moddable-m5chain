{
	"build": {
		"NAME": "m5chain-xs-tests",
		"BUILD": "$(MODDABLE)/build",
		"MODULES": "$(MODDABLE)/modules",
		"TEST262": "$(MODDABLE)/tools/test262"
	},
	"creation": {
		"static": 65536,
		"chunk": {
			"initial": 16384,
			"incremental": 512
		},
		"heap": {
			"initial": 2048,
			"incremental": 64
		},
		"stack": 384,
		"keys": {
			"available": 2048,
			"name": 127,
			"symbol": 127
		},
		"parser": {
			"buffer": 9000,
			"table": 127
		},
		"main": "main"
	},
	"include": [
		"$(MODDABLE)/examples/manifest_base.json",
		"$(MODULES)/base/modules",
		"$(MODULES)/data/url",
		"../../manifests/host.json",
		"../../manifests/devices/all.json"
	],
	"modules": {
		"*": [
			"$(TEST262)/_262",
			"$(TEST262)/harness",
			"$(MODDABLE)/tools/testmc/main",
			"$(MODDABLE)/tools/testmc/hosttest"
		],
		"commodetto/checksumOut": "./checksumOut"
	},
	"preload": ["main", "hosttest", "harness", "instrumentation", "commodetto/checksumOut"],
	"strip": [],
	"config": {
		"startupSound": "",
		"reloadOnAbort": true
	},
	"platforms": {
		"lin": {
			"build": {
				"SIMULATOR": "$(BUILD)/bin/lin/debug/mcsim"
			},
			"modules": {
				"*": ["$(BUILD)/simulators/modules/screen", "$(MODULES)/base/timer/timer", "$(MODULES)/base/timer/lin/*"]
			}
		},
		"mac": {
			"build": {
				"SIMULATOR": "$(BUILD)/bin/mac/debug/mcsim.app"
			},
			"modules": {
				"*": [
					"$(BUILD)/simulators/modules/screen",
					"$(MODULES)/base/time/*",
					"$(MODULES)/base/time/mac/*",
					"$(MODULES)/base/timer/*",
					"$(MODULES)/base/timer/mac/*"
				]
			}
		},
		"win": {
			"build": {
				"SIMULATOR": "$(BUILD)/bin/win/debug/mcsim.exe"
			},
			"modules": {
				"*": [
					"$(BUILD)/simulators/modules/screen",
					"$(MODULES)/base/time/*",
					"$(MODULES)/base/time/win/*",
					"$(MODULES)/base/timer/*",
					"$(MODULES)/base/timer/win/*"
				]
			}
		}
	}
}
